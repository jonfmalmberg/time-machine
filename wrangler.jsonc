// Cloudflare deploy settings. The site is static files only: build.py writes
// dist/, Cloudflare serves it. No Worker code runs, so nothing is billable.
{
  "name": "time-machine",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  // Needed for branch previews; empty because previews use the same settings.
  "previews": {}
}
